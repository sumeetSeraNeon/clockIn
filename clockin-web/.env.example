# ClockIn web — copy to .env.local and fill in.
# Do not commit .env.local.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000/api

# Organisation code shown on "Request access" (seed default: CLK)
NEXT_PUBLIC_ORG_CODE=CLK

# Firebase Web SDK (Console → Project settings → Your apps → Web app)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
