# Local development — copy to .env and fill in your Postgres password.
# Use 127.0.0.1 (not localhost) on Windows to avoid IPv6 auth issues.
# Do not commit .env.
PORT=3000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/clockin?schema=public

# Comma-separated browser origins allowed to call the API (Next.js on :3001)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Firebase Admin (Nest verifies ID tokens). Prefer the file path locally.
# Put the downloaded service-account JSON somewhere safe, e.g.:
#   clockIn/clockin-api/secrets/firebase-service-account.json
# That folder/file must stay out of git.
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\YOUR_WINDOWS_USER\OneDrive - seraneon.co.uk\Desktop\main-clockin\clockIn\clockin-api\secrets\firebase-service-account.json
FIREBASE_PROJECT_ID=clockin-dev-84f43

# Web API key (Project settings → General) — used by scripts/get-firebase-id-token.mjs only
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_WEB_API_KEY

# Optional defaults for the ID-token script
# FIREBASE_TEST_EMAIL=owner@clockin.local
# FIREBASE_TEST_PASSWORD=choose-a-dev-password

# Phase2 FIX6 — invite email (optional). Without SMTP, invite still works and returns a shareable password link.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="ClockIn <noreply@example.com>"
# APP_NAME=ClockIn

